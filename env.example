# EXAMPLES ONLY. Enter real values only in your hosting provider's secret settings.
# This file is not loaded automatically.
AUTH_PROVIDER=supabase
SERVE_WEB=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Supabase Connect > Session pooler (IPv4). URL-encode reserved password characters.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
# Set by Railway. For a manual local process only:
# PORT=3000
# Database credentials and secret/service_role keys must never use VITE_*.
# The Railway build selects VITE_AUTH_PROVIDER=supabase itself.
